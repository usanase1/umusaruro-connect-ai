# Template only. Copy to .env and put real values there. NEVER put real keys in this file.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
# Public HTTPS URL Africa's Talking uses to reach this service (your ngrok URL in dev).
PUBLIC_BASE_URL=https://xxxx-xx-xx.ngrok-free.app
# Optional shared token appended to the callback URL (?token=...) so random
# requests to /voice/* are rejected. Put the same token in the AT dashboard URL.
VOICE_WEBHOOK_TOKEN=

# ─── Core backend (umusarurop2p-be) ──────────────────────────────────────────
BACKEND_URL=http://localhost:5000/api
# Must match the backend's .env exactly. Secret: at least 32 characters.
INTERNAL_SERVICE_ID=umusaruro-connect-ai
INTERNAL_SERVICE_SECRET=

# ─── Speech providers (swappable) ────────────────────────────────────────────
# mock | pindo | sunbird
STT_PROVIDER=mock
TTS_PROVIDER=mock
# What the mock STT "hears" from every recording (for local testing).
MOCK_STT_TEXT=Umushinga wanjye ugeze he?
PINDO_API_KEY=
SUNBIRD_API_KEY=

# ─── AI ──────────────────────────────────────────────────────────────────────
# Leave empty to use the built-in template answer (no LLM call).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
